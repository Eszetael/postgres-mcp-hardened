{
  "manifest_version": "0.3",
  "name": "postgres-mcp-hardened",
  "display_name": "PostgreSQL (read-only, hardened)",
  "version": "0.1.0",
  "description": "Read-only PostgreSQL MCP server in Rust: AST-enforced read-only queries plus database-level read-only transaction, per-session statement_timeout, schema inspection.",
  "author": { "name": "<AUTHOR>" },
  "repository": "<REPO_URL>",
  "homepage": "<REPO_URL>",
  "license": "MIT",
  "keywords": ["postgresql", "mcp", "read-only", "rust", "database"],
  "server": {
    "type": "binary",
    "entry_point": "bin/postgres-mcp-hardened",
    "mcp_config": {
      "command": "bin/postgres-mcp-hardened",
      "args": ["--stdio"],
      "env": {
        "DATABASE_URL": "${user_config.database_url}",
        "MCP_MAX_COST": "${user_config.max_cost}"
      }
    }
  },
  "user_config": {
    "database_url": {
      "type": "string",
      "title": "PostgreSQL connection string",
      "description": "PostgreSQL connection string (postgres:// URL). Use a read-only role for defense in depth.",
      "sensitive": true,
      "required": true
    },
    "max_cost": {
      "type": "number",
      "title": "Max query cost (EXPLAIN planner estimate)",
      "description": "Reject queries whose estimated planner cost exceeds this value.",
      "required": false,
      "default": 1000000
    }
  },
  "tools": [
    { "name": "query", "description": "Execute a read-only SQL query" },
    { "name": "list_schemas", "description": "List all schemas" },
    { "name": "list_tables", "description": "List tables in a schema" },
    { "name": "describe_table", "description": "Describe table columns" }
  ],
  "tools_generated": false,
  "compatibility": {
    "claude_desktop": ">=1.0.0",
    "platforms": ["darwin", "win32", "linux"]
  }
}
